# ==========================================================
# Résidence Catalog — variables d'environnement
# Copier en .env et remplir avant `pnpm dev`
# ==========================================================

# --- Base de données ---
DATABASE_URL="postgresql://user:password@localhost:5432/residence_catalog"

# --- PostgreSQL (stack de production docker-compose.prod.yml) ---
# Utilisées par les services db/migrate/api du compose prod. Défauts : postgres/residence_catalog.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""                    # REQUIS en prod — la stack refuse de démarrer sans
POSTGRES_DB="residence_catalog"

# --- Web (build de production) ---
# URL publique de l'API, inlinée au build Next.js (côté navigateur).
# Ex : https://api.residence-catalog.tg. Défaut : http://localhost:3001
NEXT_PUBLIC_API_URL="http://localhost:3001"

# URL publique du site web (page "mot de passe oublié"). Utilisée par l'API
# pour construire le lien de réinitialisation envoyé par email.
# Ex : https://app.residence-catalog.tg. Défaut : http://localhost:3000
PUBLIC_WEB_URL="http://localhost:3000"

# --- Base de données de test (e2e / integration) ---
# Doit pointer sur une DB séparée pour ne pas polluer la DB de dev
# pendant les TRUNCATE des suites de tests.
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/residence_catalog_test"

# --- Redis (lock réservation + BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Auth JWT ---
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too-different-from-jwt-secret"

# --- Serveur ---
PORT=3001
# Origines CORS autorisées (séparées par des virgules). Jamais `*` :
# les cookies httpOnly exigent une liste explicite + credentials.
CORS_ORIGINS="http://localhost:3000"

# --- CinetPay (paiements locaux XOF / mobile money) ---
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""          # pour vérification signature webhook

# --- Stripe (paiements diaspora EUR) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""        # whsec_... pour vérification signature webhook

# --- Notifications push (à définir selon provider choisi) ---
# FIREBASE_PROJECT_ID=""
# FIREBASE_PRIVATE_KEY=""
# FIREBASE_CLIENT_EMAIL=""

# --- Email SMTP (remise des liens de reset mot de passe) ---
# Relais SMTP générique (Resend, Brevo, Mailgun, SMTP mutualisé, …).
# Sans SMTP_HOST, l'API reste en mode démo (token loggé hors production).
SMTP_HOST=""                      # ex : smtp.resend.com
SMTP_PORT="587"
SMTP_SECURE="false"               # "true" pour le port 465 (TLS direct)
SMTP_USER=""                      # ex : resend (clé API en mot de passe)
SMTP_PASS=""
SMTP_FROM=""                      # ex : no-reply@residence-catalog.tg

# --- Email/SMS (à définir selon provider choisi) ---
# SMS_PROVIDER_API_KEY=""
