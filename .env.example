# ==========================================================
# Résidence Catalog — variables d'environnement
# Copier en .env et remplir avant `pnpm dev`
# ==========================================================

# --- Base de données ---
DATABASE_URL="postgresql://user:password@localhost:5432/residence_catalog"

# --- PostgreSQL (stack de production docker-compose.prod.yml) ---
# Utilisées par les services db/migrate/api du compose prod. Défauts : postgres/residence_catalog.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""                    # REQUIS en prod — la stack refuse de démarrer sans
POSTGRES_DB="residence_catalog"

# --- Web (build de production) ---
# URL publique de l'API, inlinée au build Next.js (côté navigateur).
# Requise par le compose prod.
NEXT_PUBLIC_API_URL="https://api.immo-les-terrasse.com"

# Domaines publics routés par l'Nginx hôte (server blocks infra/nginx/).
# Le DNS A de ces noms DOIT pointer vers le VPS avant `certbot --nginx`.
WEB_DOMAIN="immo-les-terrasse.com"
API_DOMAIN="api.immo-les-terrasse.com"

# URL publique du site web (page "mot de passe oublié"). Utilisée par l'API
# pour construire le lien de réinitialisation envoyé par email.
PUBLIC_WEB_URL="https://immo-les-terrasse.com"

# --- Base de données de test (e2e / integration) ---
# Doit pointer sur une DB séparée pour ne pas polluer la DB de dev
# pendant les TRUNCATE des suites de tests.
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/residence_catalog_test"

# --- Redis (lock réservation + BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Backblaze B2 (stockage objet : KYC, contrats PDF, signatures) ---
# Clé d'application DÉDIÉE au bucket applicatif (jamais la clé du bucket
# de sauvegarde restic). Les fichiers sont stockés sous des clés internes
# et servis via des URL signées temporaires (TTL par défaut : 900 s).
B2_KEY_ID=""                    # access key ID Backblaze
B2_APPLICATION_KEY=""           # secret application key Backblaze
B2_BUCKET="les-terrasses-prod-files"
B2_ENDPOINT=""                  # ex : https://s3.us-west-004.backblazeb2.com
B2_REGION=""                    # ex : us-west-004 (région du bucket)
B2_SIGNED_URL_TTL_SECONDS="900" # durée de vie des URL signées (15 min)

# --- Backblaze B2 — bucket PUBLIC (médias catalogue : rendus 3D, photos, plans) ---
# Clé applicative SÉPARÉE, scopée au bucket public (moindre privilège) : elle ne
# peut rien sur les documents légaux du bucket privé. Les fichiers sont servis via
# une URL stable SANS signature (lisible par tout visiteur, cacheable), clés
# internes `unit-media/<uuid>.<ext>`. Upload toujours authentifié (un bucket B2
# public n'est jamais publiquement writable).
B2_PUBLIC_BUCKET="les-terrasses-media-public"
B2_PUBLIC_ENDPOINT=""           # ex : https://s3.us-west-004.backblazeb2.com (région du bucket public)
B2_PUBLIC_KEY_ID=""             # access key ID Backblaze scopé au bucket public
B2_PUBLIC_APPLICATION_KEY=""    # secret application key scopé au bucket public

# --- Auth JWT ---
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too-different-from-jwt-secret"

# --- Serveur ---
PORT=3001
# Origines CORS autorisées (séparées par des virgules). Jamais `*` :
# les cookies httpOnly exigent une liste explicite + credentials.
CORS_ORIGINS="https://immo-les-terrasse.com"
# Domaine racine (avec point) posé sur les cookies de session. Requis en
# production : le cookie posé par api.immo-les-terrasse.com doit être partagé
# avec le frontend immo-les-terrasse.com. Doit couvrir les DEUX sous-domaines.
# Absent en dev local (localhost reste fonctionnel).
COOKIE_DOMAIN=".immo-les-terrasse.com"

# --- CinetPay (paiements locaux XOF / mobile money) ---
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""          # pour vérification signature webhook

# --- Stripe (paiements diaspora EUR) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""        # whsec_... pour vérification signature webhook

# --- Notifications push (à définir selon provider choisi) ---
# FIREBASE_PROJECT_ID=""
# FIREBASE_PRIVATE_KEY=""
# FIREBASE_CLIENT_EMAIL=""

# --- Email SMTP (remise des liens de reset mot de passe) ---
# Relais SMTP générique (Resend, Brevo, Mailgun, SMTP mutualisé, …).
# Sans SMTP_HOST, l'API reste en mode démo (token loggé hors production).
SMTP_HOST=""                      # ex : smtp.resend.com
SMTP_PORT="587"
SMTP_SECURE="false"               # "true" pour le port 465 (TLS direct)
SMTP_USER=""                      # ex : resend (clé API en mot de passe)
SMTP_PASS=""
SMTP_FROM=""                      # ex : no-reply@residence-catalog.tg

# --- Email/SMS (à définir selon provider choisi) ---
# SMS_PROVIDER_API_KEY=""
